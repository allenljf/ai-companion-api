IMAGE_HERO_MODEL=@cf/black-forest-labs/flux-2-klein-4b
IMAGE_DECORATION_MODEL=@cf/black-forest-labs/flux-1-schnell

# Neon Postgres 連線字串（取代原設計的 SQLite；階段 6 前主要當 cache/gallery/lock 用）
